{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "plugins": ["react", "import", "typescript"],
  "jsPlugins": ["./scripts/oxlint-ui-plugin.mjs"],
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    "build/**",
    ".react-router/**",
    "coverage/**",
    "app/db/migrations/**"
  ],
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "import/no-cycle": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "checkThenables": true
      }
    ],
    "typescript/no-misused-promises": [
      "error",
      {
        "checksVoidReturn": {
          "attributes": false
        }
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "app/components/admin/events/form.tsx",
        "app/components/auth/access-form.tsx",
        "app/components/shared/client-data-table.tsx",
        "app/components/shared/file-upload-field.tsx",
        "app/components/shared/server-data-table.tsx",
        "app/features/admin/academies/detail/view.tsx",
        "app/features/admin/dancers/detail/form.tsx",
        "app/features/admin/professors/detail/form.tsx",
        "app/features/admin/users/create/view.tsx",
        "app/features/portal/dancers/detail/form.tsx",
        "app/features/portal/professors/detail/view.tsx",
        "app/features/portal/profile/view.tsx",
        "app/lib/admin/users/user-detail-edit-form.tsx",
        "app/lib/admin/users/user-detail-password-reset-form.tsx"
      ],
      "rules": {
        "react-hooks/exhaustive-deps": "off"
      }
    },
    {
      "files": ["app/**/*.tsx"],
      "excludeFiles": ["app/components/ui/**", "**/*.test.tsx"],
      "rules": {
        "ui/no-raw-form-element": "error",
        "ui/no-restyle": "error"
      }
    },
    {
      "files": [
        "app/components/shared/file-upload-compact-control.tsx",
        "app/components/shared/file-upload-field.tsx",
        "app/features/admin/comprobantes/print/view.tsx"
      ],
      "rules": {
        "ui/no-raw-form-element": "off"
      }
    },
    {
      "files": [
        "app/components/admin/shell.tsx",
        "app/components/auth/access-ui.tsx",
        "app/components/portal/ui.tsx",
        "app/components/shared/combobox-field.tsx",
        "app/components/shared/data-table-shell.tsx",
        "app/components/shared/en-escena-avatar.tsx",
        "app/components/shared/home-access-card.tsx",
        "app/components/shared/multi-combobox.tsx",
        "app/features/admin/presentations/list/view.tsx",
        "app/features/portal/dancers/detail/view.tsx",
        "app/features/portal/professors/detail/view.tsx"
      ],
      "rules": {
        "ui/no-restyle": "off"
      }
    }
  ]
}
