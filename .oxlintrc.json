        "app/features/admin/professors/detail/form.tsx",
        "app/features/admin/users/create/view.tsx",
        "app/features/portal/dancers/detail/form.tsx",
        "app/features/portal/professors/detail/view.tsx",
        "app/features/portal/profile/view.tsx",
        "app/lib/admin/users/user-detail-edit-form.tsx",
        "app/lib/admin/users/user-detail-password-reset-form.tsx"
      ],
      "rules": {
        "react-hooks/exhaustive-deps": "off"
      }
    },
    {
      "files": ["app/**/*.tsx"],
      "excludeFiles": ["app/components/ui/**", "**/*.test.tsx"],
      "rules": {
        "ui/no-raw-form-element": "error",
        "ui/no-restyle": "error",
        "ui/tabs-line-variant": "error",
        "ui/data-icon-position": "error",
        "ui/dialog-width": "error",
        "ui/actions-menu-text-only": "error",
        "ui/confirm-wording": "error",
        "ui/confirmation-shared": "error",
        "ui/alert-structure": "error"
      }
    },
    {
      "files": ["app/**/*.ts", "app/**/*.tsx"],
      "excludeFiles": ["app/components/ui/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "ui/no-borrar": "error",
        "ui/restricted-syntax": "error"
      }
    },
    {
      "files": ["app/**/*.ts", "app/**/*.tsx"],
      "excludeFiles": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "code/catch-reason": "error"
      }
    },
    {
      "files": ["app/**/*.ts", "app/**/*.tsx"],
      "excludeFiles": [
        "app/lib/shared/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test-support.ts",
        "**/*.test-support.tsx",
        "**/test-support/**"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "A network call is a named function in app/lib/shared/ (like email.server.ts or decode-audio.ts); the app's own data goes through loaders, actions and fetchers."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "globalThis",
            "property": "fetch",
            "message": "A network call is a named function in app/lib/shared/ (like email.server.ts or decode-audio.ts); the app's own data goes through loaders, actions and fetchers."
          },
          {
            "object": "window",
            "property": "fetch",
            "message": "A network call is a named function in app/lib/shared/ (like email.server.ts or decode-audio.ts); the app's own data goes through loaders, actions and fetchers."
          },
          {
            "object": "self",
            "property": "fetch",
            "message": "A network call is a named function in app/lib/shared/ (like email.server.ts or decode-audio.ts); the app's own data goes through loaders, actions and fetchers."
          }
        ]
      }
