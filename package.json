{
  "name": "en-escena",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "node --env-file=.env node_modules/@react-router/serve/bin.js ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "oxlint",
    "test": "pnpm test:unit && pnpm test:db",
    "test:unit": "vitest --run",
    "test:watch": "vitest",
    "test:db": "vitest --config vitest.db.fast.config.ts --run",
    "test:db:postgres": "pnpm db:test:reset && vitest --config vitest.db.config.ts --run",
    "check:banned-imports": "node --import tsx scripts/check-banned-imports.ts",
    "check:comment-language": "node --import tsx scripts/check-comment-language.ts",
    "check:file-tokens": "node --import tsx scripts/check-file-tokens.ts",
    "check:doc-map": "node scripts/check-doc-map.mjs",
    "check:migration-immutability": "node scripts/check-migration-immutability.mjs",
    "check:migration-order": "node scripts/check-migration-order.mjs",
    "check:repo-styles": "node --import tsx scripts/repo-style-guardrail.ts",
    "check:fallow": "fallow audit --quiet --gate-marker agent --base origin/master",
    "afk:watch": "node scripts/afk-watch.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:baseline": "node --env-file-if-exists=.env --import tsx scripts/baseline-migrations.ts",
    "backup:storage:b2": "sh scripts/backup-storage-to-b2.sh",
    "restore:storage:drill": "sh scripts/restore-drill-from-b2.sh",
    "restore:db:drill": "sh scripts/restore-drill-database.sh",
    "restore:db:drill:b2": "sh scripts/restore-drill-database-from-b2.sh",
    "db:refresh:prod": "node scripts/refresh-local-db-from-production.mjs",
    "db:test:reset": "node --import tsx tests/db/reset-test-schema.ts",
    "db:studio": "node --env-file=.env node_modules/drizzle-kit/bin.cjs studio",
    "setup:secrets": "bash scripts/setup-github-secrets.sh",
    "agent:implement": "pnpm exec tsx .sandcastle/agent-implement/implement.mts",
    "agent:write-pr": "pnpm exec tsx .sandcastle/agent-write-pr/write-pr.mts",
    "agent:review": "pnpm exec tsx .sandcastle/agent-review/review.mts"
  },
  "dependencies": {
    "@arcasdk/core": "^2.0.2",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@react-router/fs-routes": "^7.18.3",
    "@react-router/node": "^7.18.3",
    "@react-router/serve": "^7.18.3",
    "@tanstack/react-table": "^8.21.3",
    "@types/qrcode": "^1.5.6",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.2.2",
    "lucide-react": "^0.525.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-router": "^7.18.3",
    "resend": "^6.28.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@electric-sql/pglite": "^0.5.8",
    "@react-router/dev": "^7.18.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "fallow": "^2.104.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{css,html,json,md,mdx,mjs,cjs,js,jsx,ts,tsx,yml,yaml}": "prettier --write"
  }
}
