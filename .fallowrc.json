{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}",
    "tests/db/setup-fast.ts",
    "tests/db/setup.ts",
    // A one-off script run by hand, not through `package.json`, and deleted
    // once it has run in production (docs/operations/scripts.md).
    "scripts/release-withdrawn-excess.ts"
  ],
  "ignorePatterns": ["tests/setup/react-test-env.ts"],
  // `shadcn` is a devDependency on purpose: its only production use is the
  // `@import "shadcn/tailwind.css"` in `app/app.css`, which Tailwind inlines at
  // build time, so nothing resolves it at runtime.
  // `@fontsource/montserrat` is read from disk, not imported: the certificate
  // PDF embeds its static font files, which `pdf.server.ts` finds with
  // `require.resolve` at runtime.
  "ignoreDependencies": ["shadcn", "@fontsource/montserrat"],
  "ignoreExports": [
    {
      "file": "tests/db/fast-db.ts",
      "exports": ["closeTestDatabase"]
    },
    {
      "file": "app/lib/portal/dancers.server.ts",
      "exports": ["*"]
    },
    {
      "file": "app/lib/portal/professors.server.ts",
      "exports": ["*"]
    },
    {
      "file": "app/features/portal/choreographies/test-support/db.ts",
      "exports": ["*"]
    },
    {
      "file": "app/features/portal/test-support/db.ts",
      "exports": ["*"]
    },
    {
      "file": "app/lib/presentations/evaluation-lock.test-support.ts",
      "exports": ["*"]
    },
    {
      "file": "app/components/ui/alert-dialog.tsx",
      "exports": ["*"]
    },
    {
      "file": "app/components/ui/avatar.tsx",
      "exports": ["*"]
    },
    {
      "file": "app/components/ui/button-group.tsx",
      "exports": ["*"]
    },
    {
      "file": "app/components/ui/breadcrumb.tsx",
      "exports": ["*"]
    },
    {
      "file": "app/components/ui/card.tsx",
      "exports": ["*"]
    },
    {
      "file": "app/components/ui/combobox.tsx",
      "exports": ["*"]
    },
    {
      "file": "app/components/ui/dialog.tsx",
      "exports": ["*"]
    },
    {
      "file": "app/components/ui/dropdown-menu.tsx",
      "exports": ["*"]
    },
    {
      "file": "app/components/ui/empty.tsx",
      "exports": ["*"]
    },
    {
      "file": "app/components/ui/field.tsx",
      "exports": ["*"]
    },
    {
      "file": "app/components/ui/input-group.tsx",
      "exports": ["*"]
    },
    {
      "file": "app/components/ui/select.tsx",
      "exports": ["*"]
    },
    {
      "file": "app/components/ui/sheet.tsx",
      "exports": ["*"]
    },
    {
      "file": "app/components/ui/table.tsx",
      "exports": ["*"]
    }
  ],
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3
    // Common additions (uncomment to enable):
    // "ignore": [
    //   "**/lib/**",          // for repos that publish transpiled output to lib/
    //   "**/legacy/**",       // for repos with legacy-build artifacts
    //   "**/__generated__/**", // Relay, GraphQL Code Generator
    //   "**/generated/**"     // OpenAPI, Protobuf codegen
    // ]
  },
  "rules": {
    "unused-dependencies": "warn"
  }
}
